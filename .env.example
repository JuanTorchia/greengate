# =============================================================================
# GreenGate — environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# ---- PostgreSQL (Railway-managed in production) ----
DATABASE_URL="postgresql://user:pass@localhost:5432/greengate?schema=public"

# ---- Auth0 Universal Login (user sign-in) ----
# Create a Regular Web Application in the Auth0 dashboard.
# See: https://auth0.com/docs/quickstart/webapp/nextjs
AUTH0_SECRET=""                              # openssl rand -hex 32
AUTH0_BASE_URL="http://localhost:3000"
AUTH0_ISSUER_BASE_URL="https://YOUR-TENANT.us.auth0.com"
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""

# ---- Auth0 CIBA (agent approval flow) ----
# Separate M2M application with the CIBA grant type enabled.
# See: https://auth0.com/docs/get-started/authentication-and-authorization-flow/client-initiated-backchannel-authentication-flow
AUTH0_CIBA_CLIENT_ID=""
AUTH0_CIBA_CLIENT_SECRET=""
AUTH0_CIBA_AUDIENCE=""                       # API identifier for the scoped token

# ---- Google Gemini ----
# See: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# ---- Snowflake (free trial) ----
# Sign up: https://signup.snowflake.com/
SNOWFLAKE_ACCOUNT=""                         # e.g. xy12345.us-east-1
SNOWFLAKE_USERNAME=""
SNOWFLAKE_PASSWORD=""
SNOWFLAKE_WAREHOUSE="COMPUTE_WH"
SNOWFLAKE_DATABASE="GREENGATE"
SNOWFLAKE_SCHEMA="PUBLIC"
SNOWFLAKE_ROLE="ACCOUNTADMIN"

# ---- Feature flags ----
# "mock" reads factors from src/lib/emissions/mock-data.json.
# "snowflake" uses the live warehouse.
EMISSIONS_SOURCE="mock"
